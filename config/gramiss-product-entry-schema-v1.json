{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gramiss.ir/contracts/product-entry-v1.schema.json",
  "title": "Gramiss Product Entry Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "slug",
    "product_type",
    "primary_category_slug",
    "parent_sku",
    "full_description",
    "short_description",
    "index_intent",
    "images"
  ],
  "properties": {
    "name": {"type": "string", "minLength": 2},
    "slug": {"type": "string", "minLength": 2},
    "product_type": {"type": "string", "enum": ["simple", "variable"]},
    "primary_category_slug": {"type": "string", "minLength": 1},
    "secondary_category_slugs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "parent_sku": {"type": "string", "minLength": 1},
    "full_description": {"type": "string", "minLength": 1},
    "short_description": {"type": "string", "minLength": 1},
    "index_intent": {"type": "string", "enum": ["index", "noindex"]},
    "noindex_reason": {"type": "string"},
    "price": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "string", "minLength": 1}]},
    "stock_status": {"type": "string", "enum": ["instock", "outofstock", "onbackorder"]},
    "manage_stock": {"type": "boolean"},
    "stock_quantity": {"type": ["integer", "null"], "minimum": 0},
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alt"],
        "properties": {
          "attachment_id": {"type": "integer", "minimum": 1},
          "source": {"type": "string", "minLength": 1},
          "alt": {"type": "string", "minLength": 1},
          "featured": {"type": "boolean"}
        },
        "anyOf": [
          {"required": ["attachment_id"]},
          {"required": ["source"]}
        ]
      }
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taxonomy", "values", "visible", "variation"],
        "properties": {
          "taxonomy": {"type": "string", "minLength": 1},
          "values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "visible": {"type": "boolean"},
          "variation": {"type": "boolean"}
        }
      }
    },
    "variations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sku", "price", "stock_status", "attributes"],
        "properties": {
          "sku": {"type": "string", "minLength": 1},
          "price": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "string", "minLength": 1}]},
          "stock_status": {"type": "string", "enum": ["instock", "outofstock", "onbackorder"]},
          "manage_stock": {"type": "boolean"},
          "stock_quantity": {"type": ["integer", "null"], "minimum": 0},
          "attributes": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "verified_notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"product_type": {"const": "simple"}}, "required": ["product_type"]},
      "then": {"required": ["price", "stock_status"]}
    },
    {
      "if": {"properties": {"product_type": {"const": "variable"}}, "required": ["product_type"]},
      "then": {
        "required": ["attributes", "variations"],
        "properties": {"variations": {"minItems": 1}}
      }
    },
    {
      "if": {"properties": {"index_intent": {"const": "noindex"}}, "required": ["index_intent"]},
      "then": {"required": ["noindex_reason"], "properties": {"noindex_reason": {"minLength": 3}}}
    }
  ]
}
