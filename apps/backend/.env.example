NODE_ENV=development
DATABASE_URL=postgres://gramiss:gramiss_local_only@localhost:5432/gramiss
REDIS_URL=redis://localhost:6379

STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECRET=replace-with-at-least-32-random-characters

# Add real provider secrets only in the deployment platform.
# Never commit payment, email, SMS, or storage secrets.

# Set true only when deploying to Medusa Cloud, which manages Redis.
MEDUSA_CLOUD=false
